#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    // 逗号/双引号 同键：直接按=逗号，Shift=双引号

    comma_dquote: comma_dquote {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp PRINTSCREEN   &kp N1                &kp N2        &kp N3            &kp N4                &kp N5  &kp N6    &kp N7                 &kp N8             &kp N9             &kp N0                    &kp GRAVE
&kp ESC           &kp Q                 &kp W         &kp E             &kp R                 &kp T   &kp Y     &kp U                  &kp I              &kp O              &kp P                     &kp BSLH
&kp TAB           &kp A               &kp S         &kp D             &lt 3 F               &kp G   &lt 6 H     &kp J                  &kp K              &kp L              &kp SPACE               &kp BACKSPACE
&kp ENTER         &kp Z                 &kp X         &kp C             &kp V                 &kp B   &kp N     &kp M                  &kp COMMA          &kp DOT            &kp UP_ARROW              &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN          &kp LEFT_ALT  &kp LEFT_GUI      &kp LEFT_SHIFT        &mo 4   &mkp MB1  &kp LEFT_ALT         &kp LEFT_CONTROL   &kp LEFT_ARROW     &kp DOWN_ARROW            &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        F_layers {
            bindings = <
&kp F12  &kp F1          &kp F2          &kp F3        &kp F4           &trans     &kp F6     &kp F7     &kp F8  &kp F9  &kp F10   &kp F11
&trans   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2   &none      &kp F7     &kp F8  &kp F9  &trans    &trans
&trans   &trans          &trans          &trans        &kp LEFT_SHIFT   &mkp LCLK  &mkp MB4   &kp F4     &kp F5  &kp F6  &mkp MB5  &trans
&trans   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none      &none      &kp F1     &kp F2  &kp F3  &none     &trans
&trans   &trans          &trans          &trans        &trans           &trans     &mkp LCLK  &mkp RCLK  &trans  &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &bootloader
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans        &trans         &trans        &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp MINUS       &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp EQUAL    &kp SEMICOLON
&trans  &trans  &trans  &trans  &trans  &trans  &kp UNDERSCORE  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp KP_PLUS  &comma_dquote
&trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_0    &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &mkp MB2      &kp BACKSPACE  &trans        &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        nav_layer {
            bindings = <
&trans  &trans  &trans             &trans             &trans               &trans   &trans          &trans            &trans             &trans          &trans           &trans
&trans  &trans  &kp F7             &kp F8             &kp F9               &kp F12  &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
&trans  &trans  &kp F4             &kp F5             &kp F6             &kp F11  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW       &kp RIGHT       &trans           &trans
&trans  &trans  &kp F1             &kp F2             &kp F3               &kp F10  &kp PAGE_UP     &kp PAGE_DOWN     &kp HOME           &kp END         &trans           &trans
&trans  &trans  &trans             &trans             &trans               &trans   &trans          &trans            &trans             &trans          &trans           &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mkp MCLK     &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_layer_condition {
            if-layers = <4 1>;
            then-layer = <2>;
        };
    };
};
